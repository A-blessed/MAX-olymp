# Caddy для my-olymp.ru на Windows.
#
# Заменяет собой то, что в Docker-варианте делали nginx и certbot
# вместе: TLS, раздачу статики мини-приложения и прокси в бэкенд.
# Сертификат Let's Encrypt Caddy выпускает сам при первом запуске и
# продлевает дальше без участия человека — ни webroot, ни задания в
# планировщике, ни отдельного certbot не нужно.
#
# Запуск из каталога, где лежит caddy.exe:
#
#     caddy run --config Caddyfile
#
# Требования: порты 80 и 443 свободны и доступны снаружи, A-запись
# домена указывает на эту машину. Порт 80 нужен не только для
# перенаправления — по нему Let's Encrypt подтверждает владение доменом.
#
# Бэкенд при этом слушает только петлю и наружу не смотрит вовсе:
#
#     python -m uvicorn app.main:app --host 127.0.0.1 --port 8000
#         --proxy-headers --forwarded-allow-ips 127.0.0.1
{
	# Почта для писем об истечении сертификата. Замените на свою.
	email admin@my-olymp.ru
}

# Мини-приложение обращается к API по адресу https://my-olymp.ru — он
# зашит в frontend/api.js (BASE_URL). Страница, открытая с www, дала бы
# другой origin, и каждый запрос стал бы кросс-доменным, поэтому www не
# обслуживаем, а перенаправляем.
www.my-olymp.ru {
	redir https://my-olymp.ru{uri} permanent
}

my-olymp.ru {
	encode zstd gzip

	# Адрес открывается только по https, так что незачем ждать
	# перенаправления на второй визит.
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
	}

	# Событие от MAX и любой запрос мини-приложения — небольшой JSON.
	request_body {
		max_size 1MB
	}

	# --- Бэкенд --------------------------------------------------------
	# Идёт первым: иначе file_server попытался бы найти файл и отдал бы
	# index.html вместо ответа API.
	#
	# Caddy сам проставляет X-Forwarded-For, X-Forwarded-Proto и
	# X-Forwarded-Host и передаёт исходный Host — ровно то, что в
	# deploy/nginx/proxy.conf приходится прописывать руками. Без
	# X-Forwarded-Proto uvicorn считал бы соединение обычным http и
	# подставлял http:// в перенаправлениях, а MAX такие адреса не
	# принимает.
	@backend path /api/* /webhook /health /docs /openapi.json
	handle @backend {
		reverse_proxy 127.0.0.1:8000
	}

	# --- Статика мини-приложения ---------------------------------------
	handle {
		root * C:/MAX-olymp/frontend

		# Не кэшируем: MAX открывает приложение во встроенном браузере, и
		# закэшированная версия переживает деплой — пользователь остаётся
		# на старом коде, отладить это почти невозможно.
		#
		# В отличие от nginx, повторять здесь заголовки из блока выше не
		# нужно: Caddy их складывает, а не заменяет.
		header Cache-Control "no-cache, must-revalidate"

		# Неизвестный путь отдаём тем же index.html: приложение
		# одностраничное, и попадать на 404 из-за лишнего сегмента в адресе
		# оно не должно.
		try_files {path} /index.html
		file_server
	}
}
