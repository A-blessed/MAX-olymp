# Нормализация переносов строк.
# Без этого файлы, закоммиченные с Windows, попадают в Linux-контейнер
# с CRLF — Python это переживает, а shell-скрипты и Dockerfile не всегда.
* text=auto eol=lf

# Бинарные файлы не трогать.
*.png binary
*.jpg binary
*.pdf binary
*.ico binary

# PowerShell-скрипты запускаются только на Windows, и CRLF там родной.
# BOM в них обязателен отдельно: PowerShell 5.1 читает .ps1 без BOM как
# ANSI, и кириллица в выводе рассыпается.
*.ps1 text eol=crlf
