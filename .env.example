# Шаблон переменных окружения. Скопируйте в .env и заполните.
#
#   Windows PowerShell:  Copy-Item .env.example .env
#   Linux / macOS:       cp .env.example .env
#
# Файл .env в git не попадает — он перечислен в .gitignore.
# Рабочих токенов в этом файле быть не должно.

# --- Окружение ---------------------------------------------------------
# development | production
# На сервере my-olymp.ru должно быть production: тогда /docs и
# /openapi.json наружу не отдаются.
APP_ENV=development
LOG_LEVEL=INFO
# В каком часовом поясе считается «сегодня»: от этого зависят «Срочно»,
# таймеры до этапов и запрет планировать на прошедший день.
APP_TIMEZONE=Europe/Moscow

# --- Чат-бот MAX -------------------------------------------------------
# Токен выдают организаторы хакатона либо кабинет партнёров:
# business.max.ru/self -> Чат-боты -> нужный бот -> ... -> Настройки.
# Токен даёт полный доступ к управлению ботом. Если он хоть раз попал
# в git, считайте его скомпрометированным и перевыпустите.
BOT_TOKEN=

# Ник бота без @ — нужен для диплинка https://max.ru/<botName>?startapp=...
# Узнать можно скриптом check_connection.
BOT_USERNAME=

# Домен API. Старый platform-api.max.ru больше не обслуживает ботов.
MAX_API_BASE_URL=https://platform-api2.max.ru
MAX_API_TIMEOUT=15

# --- Вебхук ------------------------------------------------------------
# Публичный HTTPS-адрес бэкенда — постоянный домен проекта.
# Только https, только порт 443 (в адресе не указывается),
# сертификат доверенного центра. Самоподписанные не принимаются.
#
# Менять эту строку нужно только для отладки на туннеле. После любой
# смены адреса подписку на события надо оформить заново:
#   docker compose run --rm backend python -m scripts.setup_webhook
PUBLIC_BASE_URL=https://my-olymp.ru
WEBHOOK_PATH=/webhook

# Приходит в заголовке X-Max-Bot-Api-Secret каждого запроса от MAX.
# 5-256 символов, только A-Z a-z 0-9 _ -. Придумайте произвольную строку.
WEBHOOK_SECRET=

# --- Мини-приложение ---------------------------------------------------
# Максимальный возраст auth_date в секундах. 0 отключает проверку —
# так делать не стоит: перехваченная строка запуска станет вечной.
LAUNCH_DATA_TTL=86400

# Origin фронтенда через запятую.
#
# Фронтенд отдаётся с того же домена, что и API, поэтому в бою
# кросс-доменных запросов нет и список нужен только для копий страницы,
# открытых с другого адреса. Если открываете копию с GitHub Pages,
# допишите https://a-blessed.github.io через запятую.
CORS_ORIGINS=https://my-olymp.ru

# --- База данных -------------------------------------------------------
# Эти значения подставляются и в Postgres, и в строку подключения бэкенда.
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
POSTGRES_PORT=5432

# --- Порты -------------------------------------------------------------
# Порт бэкенда внутри локальной сети. В проде наружу смотрит nginx на
# 80 и 443, а бэкенд на хост не публикуется вовсе.
BACKEND_PORT=8000

# --- Сертификат домена (только прод) -----------------------------------
# Домен и почта для Let's Encrypt: их использует certbot в
# docker-compose.prod.yml. Почта нужна для писем об истечении срока.
DOMAIN=my-olymp.ru
CERTBOT_EMAIL=
